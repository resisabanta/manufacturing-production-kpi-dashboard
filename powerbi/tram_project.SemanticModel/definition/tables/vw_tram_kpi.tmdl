		sourceColumn: work_quality

		annotation SummarizationSetBy = Automatic

	column performance_conclusion =

			SWITCH(
			    TRUE(),

			    vw_tram_kpi[kpi_status] = "GOOD"
			        && vw_tram_kpi[work_quality] = "PASS",
			    "OPTIMAL PERFORMANCE",

			    vw_tram_kpi[kpi_status] = "GOOD"
			        && vw_tram_kpi[work_quality] = "WARNING",
			    "FAST BUT QUALITY ISSUE",

			    vw_tram_kpi[kpi_status] = "GOOD"
			        && vw_tram_kpi[work_quality] = "REWORK",
			    "FAST BUT REWORK REQUIRED",

			    vw_tram_kpi[kpi_status] = "GOOD"
			        && vw_tram_kpi[work_quality] = "FAIL",
			    "HIGH SPEED QUALITY FAILURE",

			    vw_tram_kpi[kpi_status] = "NORMAL"
			        && vw_tram_kpi[work_quality] = "PASS",
			    "STABLE PERFORMANCE",

			    vw_tram_kpi[kpi_status] = "NORMAL"
			        && vw_tram_kpi[work_quality] = "WARNING",
			    "MINOR QUALITY ISSUE",

			    vw_tram_kpi[kpi_status] = "NORMAL"
			        && vw_tram_kpi[work_quality] = "REWORK",
			    "REWORK TREND DETECTED",

			    vw_tram_kpi[kpi_status] = "NORMAL"
			        && vw_tram_kpi[work_quality] = "FAIL",
			    "QUALITY PROBLEM",

			    vw_tram_kpi[kpi_status] = "WARNING"
			        && vw_tram_kpi[work_quality] = "PASS",
			    "SLOW BUT ACCEPTABLE",

			    vw_tram_kpi[kpi_status] = "WARNING"
			        && vw_tram_kpi[work_quality] = "WARNING",
			    "INEFFICIENT PROCESS",

			    vw_tram_kpi[kpi_status] = "WARNING"
			        && vw_tram_kpi[work_quality] = "REWORK",
			    "HIGH REWORK RISK",

			    vw_tram_kpi[kpi_status] = "WARNING"
			        && vw_tram_kpi[work_quality] = "FAIL",
			    "SERIOUS ISSUE",

			    vw_tram_kpi[kpi_status] = "CRITICAL"
			        && vw_tram_kpi[work_quality] = "PASS",
			    "VERY SLOW BUT QUALITY OK",

			    vw_tram_kpi[kpi_status] = "CRITICAL"
			        && vw_tram_kpi[work_quality] = "WARNING",
			    "HIGH RISK OPERATION",

			    vw_tram_kpi[kpi_status] = "CRITICAL"
			        && vw_tram_kpi[work_quality] = "REWORK",
			    "CRITICAL REWORK CONDITION",

			    vw_tram_kpi[kpi_status] = "CRITICAL"
			        && vw_tram_kpi[work_quality] = "FAIL",
			    "CRITICAL FAILURE",

			    "UNDEFINED"
			)
		lineageTag: 2b83eb50-5b4e-4ecb-b968-e5a9663952b5
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

