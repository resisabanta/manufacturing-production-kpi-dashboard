table vw_tram_kpi
	lineageTag: cc91fd1c-705d-4243-873a-92089f3d4104

	measure 'Total Jobs' = COALESCE(COUNTROWS('vw_tram_kpi'), 0)
		formatString: #,0
		displayFolder: Dashboard
		lineageTag: dc72781f-8fca-4cf9-98d1-74fdff55ebdd


	measure 'Average Excess %' = AVERAGE('vw_tram_kpi'[excess_percent])/100
		lineageTag: 1962cf87-a536-4776-ae5a-8fe4c263b97e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Excess Hours' = [Actual Hours] - [Planned Hours]
		formatString: #,0.0
		displayFolder: Dashboard
		lineageTag: 9d268743-c5e4-4ed5-94c6-66150474da68


	measure 'Total Overtime Hours' = SUM('vw_tram_kpi'[overtime_hours])
		formatString: #,0.0
		displayFolder: Dashboard
		lineageTag: 8a56ec48-1372-4f41-99e6-d50042a9baa2


	measure 'Rework Jobs' = COALESCE(CALCULATE(COUNTROWS('vw_tram_kpi'), KEEPFILTERS('vw_tram_kpi'[work_quality] = "REWORK")), 0)
		formatString: #,0
		displayFolder: Dashboard
		lineageTag: 8dd325ce-b37f-436d-98a7-ed7f0249b381


	measure 'Rework Rate' = DIVIDE([Rework Jobs], [Total Jobs])
		formatString: 0.0%
		displayFolder: Dashboard
		lineageTag: 39ea46b5-b5c8-4044-bd05-e0e346fde37f


	measure 'Fail Jobs' = COALESCE(CALCULATE(COUNTROWS('vw_tram_kpi'), KEEPFILTERS('vw_tram_kpi'[work_quality] = "FAIL")), 0)
		formatString: #,0
		displayFolder: Dashboard
		lineageTag: 3bd1832a-bcc9-4e50-9662-24f4dbb2185b


	measure 'Fail Rate' = DIVIDE([Fail Jobs], [Total Jobs])
		formatString: 0.0%
		displayFolder: Dashboard
		lineageTag: b1bb7de2-688b-4216-808c-f03d573370f9


	measure 'Critical Jobs' = COALESCE(CALCULATE(COUNTROWS('vw_tram_kpi'), KEEPFILTERS('vw_tram_kpi'[kpi_status] = "CRITICAL")), 0)
		formatString: #,0
		displayFolder: Dashboard
		lineageTag: 0d34b8c3-fdb1-439f-9792-79622e378ad8


	measure 'Pass Rate' = DIVIDE([Pass Jobs], [Total Jobs])
		formatString: 0.0%
		displayFolder: Dashboard
		lineageTag: 1ba47c34-711d-4b20-8611-4be543846b00


	measure 'Average Efficiency %' = AVERAGEX('vw_tram_kpi', DIVIDE('vw_tram_kpi'[planned_hours], 'vw_tram_kpi'[actual_hours]))
		formatString: 0.0%
		displayFolder: Dashboard
		lineageTag: 4499fb17-d98a-46ad-b1a8-c6307bdb3d0a


	measure 'Planned Hours' = SUM('vw_tram_kpi'[planned_hours])
		formatString: #,0.0
		displayFolder: Dashboard
		lineageTag: 64e770f2-a9b5-44cf-a42d-587df52a31fc

	measure 'Actual Hours' = SUM('vw_tram_kpi'[actual_hours])
		formatString: #,0.0
		displayFolder: Dashboard
		lineageTag: 5ef91ed7-70c6-49a6-ba79-e7a27926175e

	measure 'Overall Efficiency' = DIVIDE([Planned Hours], [Actual Hours])
		formatString: 0.0%
		displayFolder: Dashboard
		lineageTag: afa344ad-70c0-4b42-9dc7-5b183f62f623

	measure 'Positive Overrun Hours' = SUMX('vw_tram_kpi', MAX('vw_tram_kpi'[actual_hours] - 'vw_tram_kpi'[planned_hours], 0))
		formatString: #,0.0
		displayFolder: Dashboard
		lineageTag: 2867489e-9b43-48ea-ac69-5229ebf116de

	measure 'Pass Jobs' = COALESCE(CALCULATE(COUNTROWS('vw_tram_kpi'), KEEPFILTERS('vw_tram_kpi'[work_quality] = "PASS")), 0)
		formatString: #,0
		displayFolder: Dashboard
		lineageTag: 97f68268-a62f-4a3c-8e22-8e9af4fff5bd

	measure 'Selection Summary' = IF([Total Jobs] = 0, "No records match the current filters.", FORMAT([Total Jobs], "#,0") & " jobs selected | " & FORMAT([Planned Hours], "#,0.0") & " planned h | " & FORMAT([Actual Hours], "#,0.0") & " actual h")
		displayFolder: Dashboard
		lineageTag: efcf5d46-59dc-430b-a588-ce638f309f42

	measure 'Priority Task' = VAR Ranked = TOPN(1, ADDCOLUMNS(VALUES('vw_tram_kpi'[item_name]), "Impact", [Positive Overrun Hours]), [Impact], DESC, 'vw_tram_kpi'[item_name], ASC) RETURN IF([Total Jobs] = 0, "No records selected", IF([Positive Overrun Hours] <= 0, "No positive overruns in this selection", "Largest overrun impact: " & CONCATENATEX(Ranked, 'vw_tram_kpi'[item_name] & " | " & FORMAT([Impact], "#,0.0") & " h", ", ")))
		displayFolder: Dashboard
		lineageTag: 30f2d9f7-f81a-49da-ba67-8693fff654cf

	measure 'Warning Jobs' = COALESCE(CALCULATE(COUNTROWS('vw_tram_kpi'), KEEPFILTERS('vw_tram_kpi'[work_quality] = "WARNING")), 0)
		formatString: #,0
		displayFolder: Dashboard
		lineageTag: cfab3316-93ac-40a3-acaf-02ef4398e975

	measure 'Warning Rate' = DIVIDE([Warning Jobs], [Total Jobs])
		formatString: 0.0%
		displayFolder: Dashboard
		lineageTag: 94f4cf93-8fcc-4c7c-899e-6b4ce8fd7555

	column 'Reporting Month' = FORMAT('vw_tram_kpi'[start_time], "yyyy-MM")
